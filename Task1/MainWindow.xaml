<Window x:Class="Task1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task1"
        mc:Ignorable="d"
        Title="Решение задачи 1" 
        Height="{Binding Path=FHeight, Converter={StaticResource DBLConv}}" 
        Width="{Binding Path=FWidth, Converter={StaticResource DBLConv}}"
        FontSize="{Binding Path=LFontSize, Converter={StaticResource DBLConv}}"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" Initialized="Window_Initialized">
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}" x:Key="ParamText">
            <Style.Triggers>
                <Trigger
                    Property="Validation.HasError" Value="True">
                    <Setter Property="Background" Value="Pink"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="ToolTip"
                    Value="{Binding RelativeSource={x:Static RelativeSource.Self},  
                        Path=(Validation.Errors).CurrentItem.ErrorContent }"/>
                    
                </Trigger>
            </Style.Triggers>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <DockPanel LastChildFill="True">
                            <TextBlock Foreground="Red" 
                               FontSize="{Binding RelativeSource=
                                    {RelativeSource AncestorType={x:Type Window}}, 
                                       Path=DataContext.LFAdorFontSize, 
                                       Converter={StaticResource DBLConv} }" 
                               Text="!"
                        ToolTip="{Binding ElementName=controlWithError,
                        Path=AdornedElement.(Validation.Errors).CurrentItem.ErrorContent}"  />
                            <Border BorderBrush="Red" BorderThickness="1">
                                <AdornedElementPlaceholder Name="controlWithError" />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <local:Task1VM/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2826*"/>
            <ColumnDefinition Width="1.1304*"/>
            <ColumnDefinition Width="1.1304*"/>
            <ColumnDefinition Width="1.1304*"/>
            <ColumnDefinition Width="1.1304*"/>
            <ColumnDefinition Width="1.1304*"/>
            <ColumnDefinition Width="1.1304*"/>
            <ColumnDefinition Width="1.1304*"/>
            <ColumnDefinition Width="1.1304*"/>
            <ColumnDefinition Width="1.1304*"/>
            <ColumnDefinition Width="1.1304*"/>
            <ColumnDefinition Width="1.1304*"/>
            <ColumnDefinition Width="0.2826*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Column="1" Content="Данные для компрессии:" 
               HorizontalAlignment="Stretch" Margin="0,0,0,0" 
               Grid.Row="1" VerticalAlignment="Stretch" Padding="0,0,0,0" 
               Grid.ColumnSpan="3"/>
        <TextBox Grid.Column="1" Grid.ColumnSpan="11" HorizontalAlignment="Stretch" 
                 Margin="0,0,0,0" Padding="0,0,0,0" 
                 Grid.Row="2" Grid.RowSpan="2"
                 TextWrapping="Wrap" 
                 Text="{Binding Path=LCData2Compress, ValidatesOnDataErrors=True, 
                    UpdateSourceTrigger=PropertyChanged}" 
                 VerticalAlignment="Stretch"
                 Style="{StaticResource ResourceKey=ParamText}"
                 />
        <Button Grid.Column="4" Content="Сжать" HorizontalAlignment="Stretch" 
                Margin="0,0,0,0" Grid.RowSpan="1" Grid.Row="1" 
                Command="{Binding Path=LCommandCompress}"
                CommandParameter="{Binding Path=LCData2Compress}"
                VerticalAlignment="Stretch"/>
        <Label Grid.Column="1" Grid.ColumnSpan="3" Content="Результат компрессии:" 
               HorizontalAlignment="Stretch" 
               Margin="0,0,0,0" Grid.Row="6" VerticalAlignment="Stretch"
               Padding="0,0,0,0"/>
        <TextBox Grid.Column="1" Grid.ColumnSpan="11" HorizontalAlignment="Stretch" 
                 Margin="0,0,0,0" Grid.Row="7" Grid.RowSpan="2"
                 TextWrapping="Wrap" 
                 Text="{Binding Path=LCCompressedData}"
                 IsReadOnly="True"
                 VerticalAlignment="Stretch" />
        <Label Grid.Column="1" Grid.ColumnSpan="3" Content="Данные для декомпрессии:" 
               HorizontalAlignment="Stretch" Margin="0,0,0,0" Padding="0,0,0,0"
               Grid.Row="10" 
               VerticalAlignment="Stretch"/>
        <TextBox Grid.Column="1" Grid.ColumnSpan="11" HorizontalAlignment="Stretch" 
                 Margin="0,0,0,0" Padding="0,0,0,0"
                 Grid.RowSpan="2" Grid.Row="11" 
                 TextWrapping="Wrap" 
                 Text="{Binding Path=LCData2Decompress, ValidatesOnDataErrors=True,
                    UpdateSourceTrigger=PropertyChanged}" 
                 VerticalAlignment="Stretch"
                 Style="{StaticResource ResourceKey=ParamText}"
                 />
        <Button Grid.Column="4" Grid.ColumnSpan="2" 
                Content="Развернуть" HorizontalAlignment="Stretch" 
                Margin="0,0,0,0" Padding="0,0,0,0"
                Grid.RowSpan="1" 
                Grid.Row="10" VerticalAlignment="Stretch"
                Command="{Binding Path=LCommandDecompress}"
                CommandParameter="{Binding Path=LCData2Decompress}"
                />
        <Label Grid.Column="1" Grid.ColumnSpan="3"
               Content="Результат декомпрессии:" HorizontalAlignment="Stretch" 
               Padding="0,0,0,0"
               Grid.Row="15" VerticalAlignment="Stretch"/>
        <TextBox Grid.Column="1" Grid.ColumnSpan="11" 
                 HorizontalAlignment="Stretch" Margin="0,0,0,0" Padding="0,0,0,0" 
                 Grid.RowSpan="2" Grid.Row="16" TextWrapping="Wrap" 
                 Text="{Binding Path=LCDecompressedData}"
                 IsReadOnly="True"
                 VerticalAlignment="Stretch" />
    </Grid>
</Window>
